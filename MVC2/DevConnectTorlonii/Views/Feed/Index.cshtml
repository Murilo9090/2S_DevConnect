<h1>Pagina de Feed</h1>
@{
    ViewData["Title"] = "DevConnect - Feed";
}
<link rel="stylesheet" href=~/css/feed.css">
<body>
    <header id="cabecalho">
        <nav>
            <a id="logo-desktop" asp-controller="Home"asp-action="Index">
                <img src="../images/logo-devconnect- 2.svg" alt="Logo da empresa DevConnect">
            </a>

            <a id="logo-mobile" asp-controller="home"asp-action="Index">
                <img src="../images/logo-devconnect- 3.svg" alt="Logo da empresa DevConnect">
            </a>

            <div class="cabecalho-acoes">
                <a asp-controller="Home"asp-action="Index">
                    <img src="../images/icone-casa-vermelho.svg" alt="Ícone de casa">
                </a>

                <a href="#">
                    <img src="../images/icone-coracao-vermelho.svg" alt="Ícone de um coração">
                </a>
                
                <a asp-controller="Perfil"asp-action="Index">
                    <img class="foto-perfil" src="../images/images.jpg" alt="Foto de perfil">
                </a>
            </div>
        </nav>
    </header>

    <main>
        <h1>Tela Feed - DevConnect</h1>

        <div class="container-flex-publi">
            <section id="storys" class="estilo-formulario">
